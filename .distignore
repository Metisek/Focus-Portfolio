# Files that never go into the plugin package or onto the server.
# Read by .github/workflows/release.yml, tools/build-zip.ps1 and tools/sync-to-site.ps1.
# An entry ending with "/" is a directory (at any level); otherwise a file name (* and ? allowed).
.git/
.github/
.vscode/
tools/
dist/
build/
.gitignore
.gitattributes
.distignore
README.md
CHANGELOG.md
*.zip
*.tmp
NOTATKI.md
